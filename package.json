{
  "name": "horologium",
  "version": "1.0.0",
  "description": "High-precision interactive world timezone atlas, UTC meridian tracker, and live temporal telemetry web application.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"node server.js\" \"vite\"",
    "dev:server": "node server.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server.js",
    "preview": "vite preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0"
  }
}
